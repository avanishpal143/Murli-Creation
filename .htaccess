<IfModule mod_rewrite.c>
RewriteEngine On

# Allow existing static files directly (images/, img-prodcut/, favicon.ico)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Map /assets/... to frontend/assets/...
RewriteRule ^assets/(.*)$ frontend/assets/$1 [L,QSA]

# Map /admin.php and /admin to backend/admin.php
RewriteRule ^admin\.php$ backend/admin.php [L,QSA]
RewriteRule ^admin/?$ backend/admin.php [L,QSA]

# Map /api/... to backend/api/...
RewriteRule ^api/(.*)$ backend/api/$1 [L,QSA]

# Map root / to frontend/index.php
RewriteRule ^$ frontend/index.php [L,QSA]

# Map frontend pages directly
RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f
RewriteRule ^(.*)$ frontend/$1 [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/frontend/$1.php -f
RewriteRule ^(.*)$ frontend/$1.php [L,QSA]

# Fallback to router.php
RewriteRule ^(.*)$ router.php [L,QSA]
</IfModule>
